# Copy to backend/.env and fill in. Any key left blank -> that adapter runs in
# mock mode, so the whole pipeline still runs end-to-end.

# --- KIRI Engine (3D reconstruction) ---
KIRI_API_KEY=
# Optional: enables push-based reconstruction completion (else we poll).
KIRI_WEBHOOK_SECRET=
# Public URL where KIRI can POST webhooks (e.g. an ngrok https URL in dev).
PUBLIC_URL=

# --- Anthropic (Claude vision) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- KIRI mock: local mesh used as "reconstruction output" when no key ---
# MOCK_MESH_PATH=../data/model-mobile 2.stl
